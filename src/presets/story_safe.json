{
  "name": "Story Safe",
  "description": "Maximum safety for story integrity. Only light stat randomization, no class changes, no inventory changes. Use this if you're experiencing story crashes.",
  "version": "1.0",
  "settings": {
    "class_mode": "vanilla",
    "keep_lords": true,
    "keep_thieves": true,
    "keep_dancers": true,
    "respect_gender": true,
    "exclude_monsters": true,
    "max_class_copies": 0,
    "bases_mode": "random",
    "bases_variance": 1,
    "bases_preserve_total": true,
    "bases_min": 0,
    "bases_max": 30,
    "growths_mode": "random",
    "growths_variance": 5,
    "growths_preserve_total": true,
    "growths_min": 10,
    "growths_max": 90,
    "ranks_mode": "vanilla",
    "ranks_variance": 0,
    "ranks_fix_weapon": "raise_rank",
    "inventory_mode": "dont_change",
    "force_build": false,
    "auto_fix": true
  }
}