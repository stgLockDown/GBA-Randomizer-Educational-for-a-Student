{
  "name": "Vanilla+",
  "description": "Keep classes unchanged but randomize stats slightly. Experience the same game with subtle stat surprises. Great for purists who want a twist.",
  "version": "1.0",
  "settings": {
    "class_mode": "vanilla",
    "keep_lords": true,
    "keep_thieves": true,
    "keep_dancers": true,
    "respect_gender": true,
    "exclude_monsters": true,
    "max_class_copies": 0,
    "bases_mode": "random",
    "bases_variance": 2,
    "bases_preserve_total": true,
    "bases_min": 0,
    "bases_max": 30,
    "growths_mode": "random",
    "growths_variance": 15,
    "growths_preserve_total": true,
    "growths_min": 5,
    "growths_max": 95,
    "ranks_mode": "vanilla",
    "ranks_variance": 0,
    "ranks_fix_weapon": "raise_rank",
    "inventory_mode": "dont_change",
    "force_build": false,
    "auto_fix": true
  }
}